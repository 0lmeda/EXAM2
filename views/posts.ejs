
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CS Tutorials</title>
    <link rel="stylesheet" href="../public/css/style.css">

</head>
<body>

    <%- include("partials/navbar") %>

    <h1>CS Tutorials</h1>

    <% posts.forEach(post => { %>
        <article>
            <h2>
                <a href="/posts/<%=post.id%>">
                    <%= post.title %>
                </a>
                </h2>

            <p>Topic: <%= post.topic %></p>

            <p><%= post.content %></p>

            <% if (post.image) { %>
                <img src="<%= post.image %>" alt="Tutorial image" width="300">
            <% } %>

            <p>Published: <%= post.datePublished %></p>
        </article>

        <hr>
    <% }); %>

</body>
</html>
