
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>CS Tutorials</title>
</head>
<body>

    <%- include("partials/navbar") %>

    <h1>CS Tutorials</h1>

    <% posts.forEach(post => { %>
        <article>
            <h2><%= post.title %></h2>

            <p>Topic: <%= post.topic %></p>

            <p><%= post.content %></p>

            <% if (post.image) { %>
                <img src="<%= post.image %>" alt="Tutorial image" width="300">
            <% } %>

            <p>Published: <%= post.datePublished %></p>
        </article>

        <hr>
    <% }); %>

</body>
</html>
