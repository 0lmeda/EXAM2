<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>views</title>
</head>
<body>
    <%- include("../partials/navbar") %>
    <h1>Registered Users </h1>

    <table border="1"> 
        <thead>
            <tr>
                <th>Username</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(user => { %>
                <tr>
                    <td><%= user.username %></td>
                    <td><%= user.role %></td>
                </tr>
                <% }); %>
        </tbody>
    </table>
</body>
</html>