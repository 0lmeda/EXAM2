<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.title%></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include("partials/navbar")%>
    <main>
    <article>
        <h1><%= post.title %></h1>
        <p>Views <%= post.viewCount %></p>
        <p>Topic: <%= post.topic %></p>

        <% if (post.image) {%>
            <img src="<%=post.image%>" alt="Image" width="300px">
        <% } %>

        <p><%= post.content %></p>

        <p>Published <%= post.datePublished %></p>

        <h2>Comments</h2>

        <% comments.forEach(comment => { %>
            <p><%= comment.text %></p>
            <small><%= comment.date %></small>
            <hr>
        <% }); %>


        <h3>Likes: <%= likeCount %></h3>

        <% if (hasLiked) {%>
            <form action="/posts/<%=post.id%>/unlike" method="POST">
            <button type="submit">unlike</button>
            </form>
        <% } else { %>
            <form action="/posts/<%=post.id%>/likes" method="POST">
                <button type="submit">Like</button>
            </form>
        <% } %>

        <% if(hasBookmarked){ %>
            <form action="/posts/<%=post.id%>/unbookmark" method="post">
                <button type="submit">Remove Bookmark</button>
            </form>
        <% } else{%>
            <form action="/posts/<%=post.id%>/bookmarks" method="post">
                <button type="submit">save bookmark</button>
            </form>
        <% } %>
        <h3>Add A comment</h3>

        <form action="/posts/<%=post.id%>/comments" method="POST">
            <textarea name="text" id="textComment" required></textarea>
            <button type="submit">Submit a comment</button>
        </form>


    </article>

    <a href="/posts"> Back to posts</a>
    </main>

</body>
</html>